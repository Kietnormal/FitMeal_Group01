# Sao chép file này thành .env rồi chỉnh (KHÔNG commit file .env)
DEBUG=True
SECRET_KEY=dev-only-insecure-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# MySQL local: tạo database/user theo hướng dẫn trong README.md.
DATABASE_URL=mysql://fitmeal_app:change-this-password@127.0.0.1:3306/fitmeal
# Google OAuth credentials from Google Cloud Console (optional).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# VNPay sandbox credentials (online payment stays unavailable until both are set).
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Encrypted database backups are stored outside the project directory.
BACKUP_ROOT=C:\FitMealBackups
# Optional mounted off-site folder; leave empty if no external storage is configured.
BACKUP_EXTERNAL_ROOT=
BACKUP_ENCRYPTION_KEY=
# Email changes use this backend. Console prints confirmation links during local development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=FitMeal <noreply@fitmeal.vn>
# For real email delivery, configure your SMTP provider:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# SQLite dùng nếu không cài MySQL:
# DATABASE_URL=sqlite:///db.sqlite3

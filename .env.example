# Sao chép file này thành .env rồi chỉnh (KHÔNG commit file .env)
DEBUG=True
SECRET_KEY=dev-only-insecure-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Mặc định SQLite. Khi chạy thật, đổi sang PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/fitmeal
DATABASE_URL=sqlite:///db.sqlite3
